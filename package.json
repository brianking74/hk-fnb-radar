{
  "name": "hk-fnb-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.client.json --noEmit && vite build",
    "check": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "preview": "npm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply hkfbradar --local",
    "db:migrate:remote": "wrangler d1 migrations apply hkfbradar --remote"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.0",
    "hono": "^4.7.0",
    "i18next": "^25.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.1.0",
    "wrangler": "^4.14.0"
  }
}
